# ==============================================================================
# Store Management System - Fastify Backend Environment Configuration
# ==============================================================================

# Application environment mode: development | test | production
NODE_ENV=development

# Network interface to bind to
HOST=0.0.0.0

# HTTP port to listen on (1 - 65535)
PORT=3000

# Logging severity level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Versioned API prefix prepended to application routes
API_PREFIX=/api/v1

# Allowed CORS origins (comma-separated list of origins, e.g. http://localhost:3000,http://localhost:5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application identifier
APP_NAME=store-management-system

# Publicly reachable base URL of the API gateway / load balancer (optional)
# API_PUBLIC_URL=https://api.store.example.com

# Trust reverse proxy X-Forwarded-* headers (true when behind Nginx/ALB/Cloudflare, false otherwise)
TRUST_PROXY=false

# Maximum allowed JSON/body payload size in bytes (default: 1048576 = 1MB)
BODY_LIMIT_BYTES=1048576

# Request execution timeout in milliseconds (default: 15000 = 15s)
REQUEST_TIMEOUT_MS=15000

# Graceful shutdown deadline before forced process termination in milliseconds (default: 10000 = 10s)
SHUTDOWN_TIMEOUT_MS=10000

# Swagger / OpenAPI interactive documentation UI enabled: true | false
# Recommended: true in development, false in production unless behind a private gateway
SWAGGER_ENABLED=true

# ==============================================================================
# Database Configuration (PostgreSQL & Prisma) - Stage 2
# ==============================================================================

# PostgreSQL pooled connection string for application queries
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/store_management?schema=public

# Optional direct connection string for database migrations (e.g. Supabase, PgBouncer, Neon)
# DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/store_management?schema=public

# Maximum number of concurrent connections in the application client pool (1 - 100)
DB_POOL_MAX=10

# Connection establishment timeout in milliseconds (500 - 60000)
DB_CONNECTION_TIMEOUT_MS=5000

# ==============================================================================
# Authentication & Session Security Configuration - Stage 3
# ==============================================================================

# Cryptographically secure random secret for signing JWT access tokens (min 32 characters)
JWT_ACCESS_SECRET=your-secure-jwt-secret-min-32-characters-change-in-production!

# Access token time-to-live (e.g. 15m, 30m, 1h)
JWT_ACCESS_TTL=15m

# JWT issuer identifier
JWT_ISSUER=store-management-system

# JWT audience identifier
JWT_AUDIENCE=store-management-system-api

# Refresh token retention window in days (1 - 90)
REFRESH_TOKEN_TTL_DAYS=7

# Maximum allowed active sessions per user (FIFO session eviction when reached)
MAX_ACTIVE_SESSIONS=2

# Name of the HttpOnly cookie transporting the refresh token
AUTH_COOKIE_NAME=refresh_token

# Cryptographically secure secret for signing Fastify cookies (min 32 characters)
COOKIE_SECRET=your-secure-cookie-secret-min-32-characters-change-in-production!

# ==============================================================================
# Redis Caching, Queues & Background Jobs Configuration - Stage 8
# ==============================================================================

# Redis connection URL (standalone, Sentinel, or clustered)
REDIS_URL=redis://localhost:6379

# Redis hostname and port for individual host-based configurations
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis authentication password (leave commented if no auth in dev)
# REDIS_PASSWORD=your-redis-password

# Enable TLS encryption for secure Redis connections (rediss://)
REDIS_TLS_ENABLED=false

# Redis connection timeout in milliseconds
REDIS_CONNECT_TIMEOUT_MS=5000

# Maximum retries per command before failing
REDIS_MAX_RETRIES_PER_REQUEST=3

# Default cache time-to-live in seconds (300 = 5 minutes)
CACHE_DEFAULT_TTL_SECONDS=300

# Product catalog reference data cache TTL (600 = 10 minutes)
CACHE_CATALOG_TTL_SECONDS=600

# Store metadata reference data cache TTL (1800 = 30 minutes)
CACHE_STORE_TTL_SECONDS=1800

# Maximum concurrent background jobs per worker process
WORKER_CONCURRENCY=5

# Enable background job processor in the current process (false for API server, true for worker)
WORKER_ENABLED=false
