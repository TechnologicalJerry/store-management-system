# ==============================================================================
# Store Management System - Fastify Backend Environment Configuration
# ==============================================================================

# Application environment mode: development | test | production
NODE_ENV=development

# Network interface to bind to
HOST=0.0.0.0

# HTTP port to listen on (1 - 65535)
PORT=3000

# Logging severity level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Versioned API prefix prepended to application routes
API_PREFIX=/api/v1

# Allowed CORS origins (comma-separated list of origins, e.g. http://localhost:3000,http://localhost:5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Swagger / OpenAPI interactive documentation UI enabled: true | false
# Recommended: true in development, false in production unless behind a private gateway
SWAGGER_ENABLED=true

# ==============================================================================
# Database Configuration (PostgreSQL & Prisma) - Stage 2
# ==============================================================================

# PostgreSQL pooled connection string for application queries
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/store_management?schema=public

# Optional direct connection string for database migrations (e.g. Supabase, PgBouncer, Neon)
# DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/store_management?schema=public

# Maximum number of concurrent connections in the application client pool (1 - 100)
DB_POOL_MAX=10

# Connection establishment timeout in milliseconds (500 - 60000)
DB_CONNECTION_TIMEOUT_MS=5000
