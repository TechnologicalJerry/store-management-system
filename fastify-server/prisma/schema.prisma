// ==============================================================================
// Store Management System - Prisma Database Schema
// ==============================================================================
// Stage 2: Database & Persistence Layer Foundation
// Stage 3: Authentication, Sessions & RBAC Authorization
// Engine: PostgreSQL 17+
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ==============================================================================
// Enums
// ==============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STORE_MANAGER
  INVENTORY_MANAGER
  CASHIER
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuthAuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REFRESH
  TOKEN_REUSE_DETECTED
  SESSION_REVOKED
  ACCOUNT_SUSPENDED
  REGISTER_SUCCESS
}

// ==============================================================================
// Foundational System Settings (Stage 2)
// ==============================================================================

/// SystemSetting: Foundational key-value entity for global system parameters,
/// feature toggles, and metadata.
model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json     @db.JsonB
  description String?  @db.VarChar(255)
  isReadOnly  Boolean  @default(false) @map("is_read_only")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([key], name: "idx_system_settings_key")
  @@map("system_settings")
}

// ==============================================================================
// Authentication & Authorization Models (Stage 3)
// ==============================================================================

/// User: Core identity account entity supporting credentials and lifecycle state.
model User {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @unique @db.VarChar(255)
  passwordHash    String      @map("password_hash") @db.VarChar(255)
  name            String      @db.VarChar(100)
  status          UserStatus  @default(ACTIVE)
  emailVerifiedAt DateTime?   @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles               UserRole[]
  sessions            Session[]
  audits              AuthAudit[]
  memberships         StoreMembership[]   @relation("UserStoreMemberships")
  createdMemberships  StoreMembership[]   @relation("CreatedStoreMemberships")
  inventoryMovements  InventoryMovement[]
  createdReservations StockReservation[]
  createdTransfers    InventoryTransfer[] @relation("TransferCreatedByUser")
  approvedTransfers   InventoryTransfer[] @relation("TransferApprovedByUser")
  shippedTransfers    InventoryTransfer[] @relation("TransferShippedByUser")
  receivedTransfers   InventoryTransfer[] @relation("TransferReceivedByUser")
  createdPurchaseOrders  PurchaseOrder[]  @relation("PurchaseOrderCreatedByUser")
  approvedPurchaseOrders PurchaseOrder[]  @relation("PurchaseOrderApprovedByUser")
  receivedGoodsReceipts  GoodsReceipt[]   @relation("GoodsReceiptReceivedByUser")
  poStatusChanges        PurchaseOrderStatusHistory[] @relation("POStatusChangedByUser")
  cashierSales           Sale[]           @relation("SaleCashierUser")
  requestedRefunds       Refund[]         @relation("RefundRequestedByUser")
  reportRequests         ReportRequest[]  @relation("UserReportRequests")

  @@index([email], name: "idx_users_email")
  @@index([status], name: "idx_users_status")
  @@map("users")
}

/// UserRole: Explicit normalized mapping of users to system authorization roles.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role], name: "uq_user_roles_user_role")
  @@index([userId], name: "idx_user_roles_user_id")
  @@index([role], name: "idx_user_roles_role")
  @@map("user_roles")
}

/// Session: Persistent session tracking entity for refresh-token rotation and replay detection.
model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash") @db.VarChar(255)
  tokenFamily      String        @map("token_family") @db.Uuid
  status           SessionStatus @default(ACTIVE)
  ipAddress        String?       @map("ip_address") @db.VarChar(45)
  userAgent        String?       @map("user_agent") @db.VarChar(500)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime      @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_sessions_user_id")
  @@index([tokenFamily], name: "idx_sessions_token_family")
  @@index([status], name: "idx_sessions_status")
  @@index([expiresAt], name: "idx_sessions_expires_at")
  @@map("sessions")
}

/// AuthAudit: Security and audit log of authentication and authorization events.
model AuthAudit {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String?         @map("user_id") @db.Uuid
  email     String          @db.VarChar(255)
  action    AuthAuditAction
  ipAddress String?         @map("ip_address") @db.VarChar(45)
  userAgent String?         @map("user_agent") @db.VarChar(500)
  metadata  Json?           @db.JsonB
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_auth_audits_user_id")
  @@index([email], name: "idx_auth_audits_email")
  @@index([action], name: "idx_auth_audits_action")
  @@index([createdAt], name: "idx_auth_audits_created_at")
  @@map("auth_audits")
}

// ==============================================================================
// Store Management & Membership Models (Stage 4)
// ==============================================================================

enum StoreStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Store: Physical or operational retail store/branch entity.
model Store {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @db.VarChar(150)
  code         String            @unique @db.VarChar(50)
  description  String?           @db.VarChar(500)
  email        String?           @db.VarChar(255)
  phone        String?           @db.VarChar(50)
  addressLine1 String?           @map("address_line_1") @db.VarChar(255)
  addressLine2 String?           @map("address_line_2") @db.VarChar(255)
  city         String?           @db.VarChar(100)
  state        String?           @db.VarChar(100)
  postalCode   String?           @map("postal_code") @db.VarChar(30)
  countryCode  String?           @map("country_code") @db.VarChar(10)
  timezone     String            @default("UTC") @db.VarChar(50)
  status       StoreStatus       @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)

  members                StoreMembership[]
  inventoryBalances      InventoryBalance[]
  inventoryMovements     InventoryMovement[]
  stockReservations      StockReservation[]
  transfersAsSource      InventoryTransfer[] @relation("TransferSourceStore")
  transfersAsDestination InventoryTransfer[] @relation("TransferDestinationStore")
  destinationPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderDestinationStore")
  destinationGoodsReceipts  GoodsReceipt[]  @relation("GoodsReceiptDestinationStore")
  sales                  Sale[]           @relation("SaleStore")
  receipts               Receipt[]        @relation("ReceiptStore")
  reportRequests         ReportRequest[]  @relation("StoreReportRequests")

  @@index([code], name: "idx_stores_code")
  @@index([status], name: "idx_stores_status")
  @@map("stores")
}

/// StoreMembership: Association binding users to specific stores with store-scoped roles.
model StoreMembership {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  storeId         String           @map("store_id") @db.Uuid
  role            Role
  status          MembershipStatus @default(ACTIVE)
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User             @relation("UserStoreMemberships", fields: [userId], references: [id], onDelete: Cascade)
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdByUser   User?            @relation("CreatedStoreMemberships", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, storeId], name: "uq_store_memberships_user_store")
  @@index([userId], name: "idx_store_memberships_user_id")
  @@index([storeId], name: "idx_store_memberships_store_id")
  @@index([status], name: "idx_store_memberships_status")
  @@map("store_memberships")
}

// ==============================================================================
// Product Catalog, Categories & Variants Models (Stage 4)
// ==============================================================================

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

/// ProductCategory: Hierarchical global product taxonomy.
model ProductCategory {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(100)
  slug        String            @unique @db.VarChar(120)
  description String?           @db.VarChar(500)
  parentId    String?           @map("parent_id") @db.Uuid
  status      CategoryStatus    @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([slug], name: "idx_categories_slug")
  @@index([parentId], name: "idx_categories_parent_id")
  @@index([status], name: "idx_categories_status")
  @@map("product_categories")
}

/// Product: Core catalog entity representing a sellable product.
model Product {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(200)
  slug        String            @unique @db.VarChar(220)
  description String?           @db.Text
  categoryId  String            @map("category_id") @db.Uuid
  brand       String?           @db.VarChar(100)
  status      ProductStatus     @default(DRAFT)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)

  category    ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]

  @@index([slug], name: "idx_products_slug")
  @@index([categoryId], name: "idx_products_category_id")
  @@index([status], name: "idx_products_status")
  @@index([brand], name: "idx_products_brand")
  @@map("products")
}

/// ProductVariant: Specific sellable SKU/barcode variant with decimal pricing and attributes.
model ProductVariant {
  id          String         @id @default(uuid()) @db.Uuid
  productId   String         @map("product_id") @db.Uuid
  name        String         @db.VarChar(150)
  sku         String         @unique @db.VarChar(100)
  barcode     String?        @unique @db.VarChar(100)
  price       Decimal        @db.Decimal(12, 2)
  costPrice   Decimal?       @map("cost_price") @db.Decimal(12, 2)
  currency    String         @default("USD") @db.VarChar(3)
  taxCategory String         @default("STANDARD") @map("tax_category") @db.VarChar(50)
  attributes  Json?          @db.JsonB
  status      VariantStatus  @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  stockReservations  StockReservation[]
  transferItems      InventoryTransferItem[]
  supplierProducts   SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  saleItems          SaleItem[]

  @@index([productId], name: "idx_product_variants_product_id")
  @@index([sku], name: "idx_product_variants_sku")
  @@index([barcode], name: "idx_product_variants_barcode")
  @@index([status], name: "idx_product_variants_status")
  @@map("product_variants")
}

// ==============================================================================
// Inventory Management Models (Stage 5)
// ==============================================================================

enum MovementType {
  OPENING_STOCK
  STOCK_RECEIVED
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  SALE
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  RESERVATION_CREATED
  RESERVATION_RELEASED
  RESERVATION_FULFILLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  SHIPPED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// InventoryBalance: Current stock quantities of a product variant at a specific store.
model InventoryBalance {
  id               String         @id @default(uuid()) @db.Uuid
  storeId          String         @map("store_id") @db.Uuid
  variantId        String         @map("variant_id") @db.Uuid
  quantityOnHand   Decimal        @default(0) @map("quantity_on_hand") @db.Decimal(12, 4)
  quantityReserved Decimal        @default(0) @map("quantity_reserved") @db.Decimal(12, 4)
  reorderLevel     Decimal        @default(0) @map("reorder_level") @db.Decimal(12, 4)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  store            Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([storeId, variantId], name: "uq_inventory_balances_store_variant")
  @@index([storeId], name: "idx_inventory_balances_store_id")
  @@index([variantId], name: "idx_inventory_balances_variant_id")
  @@map("inventory_balances")
}

/// InventoryMovement: Append-only immutable audit ledger recording every inventory modification.
model InventoryMovement {
  id                String          @id @default(uuid()) @db.Uuid
  storeId           String          @map("store_id") @db.Uuid
  variantId         String          @map("variant_id") @db.Uuid
  movementType      MovementType    @map("movement_type")
  quantityDelta     Decimal         @map("quantity_delta") @db.Decimal(12, 4)
  quantityBefore    Decimal         @map("quantity_before") @db.Decimal(12, 4)
  quantityAfter     Decimal         @map("quantity_after") @db.Decimal(12, 4)
  referenceType     String?         @map("reference_type") @db.VarChar(50)
  referenceId       String?         @map("reference_id") @db.VarChar(100)
  idempotencyKey    String?         @map("idempotency_key") @db.VarChar(100)
  reason            String?         @db.VarChar(255)
  notes             String?         @db.Text
  performedByUserId String?         @map("performed_by_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  store             Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  performedByUser   User?           @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([storeId, variantId], name: "idx_inventory_movements_store_variant")
  @@index([movementType], name: "idx_inventory_movements_type")
  @@index([referenceType, referenceId], name: "idx_inventory_movements_reference")
  @@index([idempotencyKey], name: "idx_inventory_movements_idempotency")
  @@index([createdAt], name: "idx_inventory_movements_created_at")
  @@map("inventory_movements")
}

/// StockReservation: Stock held for upcoming sales or checkout operations.
model StockReservation {
  id              String            @id @default(uuid()) @db.Uuid
  storeId         String            @map("store_id") @db.Uuid
  variantId       String            @map("variant_id") @db.Uuid
  quantity        Decimal           @db.Decimal(12, 4)
  status          ReservationStatus @default(ACTIVE)
  referenceType   String?           @map("reference_type") @db.VarChar(50)
  referenceId     String?           @map("reference_id") @db.VarChar(100)
  expiresAt       DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  store           Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant         ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdByUser   User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([storeId, variantId], name: "idx_reservations_store_variant")
  @@index([status], name: "idx_reservations_status")
  @@index([referenceType, referenceId], name: "idx_reservations_reference")
  @@index([expiresAt], name: "idx_reservations_expires_at")
  @@map("stock_reservations")
}

/// InventoryTransfer: Inter-store stock transfer request and movement tracking.
model InventoryTransfer {
  id                  String                @id @default(uuid()) @db.Uuid
  transferNumber      String                @unique @map("transfer_number") @db.VarChar(50)
  sourceStoreId       String                @map("source_store_id") @db.Uuid
  destinationStoreId  String                @map("destination_store_id") @db.Uuid
  status              TransferStatus        @default(DRAFT)
  notes               String?               @db.Text
  createdByUserId     String?               @map("created_by_user_id") @db.Uuid
  approvedByUserId    String?               @map("approved_by_user_id") @db.Uuid
  shippedByUserId     String?               @map("shipped_by_user_id") @db.Uuid
  receivedByUserId    String?               @map("received_by_user_id") @db.Uuid
  shippedAt           DateTime?             @map("shipped_at") @db.Timestamptz(6)
  receivedAt          DateTime?             @map("received_at") @db.Timestamptz(6)
  cancelledAt         DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceStore         Store                 @relation("TransferSourceStore", fields: [sourceStoreId], references: [id], onDelete: Restrict)
  destinationStore    Store                 @relation("TransferDestinationStore", fields: [destinationStoreId], references: [id], onDelete: Restrict)
  createdByUser       User?                 @relation("TransferCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedByUser      User?                 @relation("TransferApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  shippedByUser       User?                 @relation("TransferShippedByUser", fields: [shippedByUserId], references: [id], onDelete: SetNull)
  receivedByUser      User?                 @relation("TransferReceivedByUser", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  items               InventoryTransferItem[]

  @@index([transferNumber], name: "idx_transfers_transfer_number")
  @@index([sourceStoreId], name: "idx_transfers_source_store_id")
  @@index([destinationStoreId], name: "idx_transfers_dest_store_id")
  @@index([status], name: "idx_transfers_status")
  @@map("inventory_transfers")
}

/// InventoryTransferItem: Specific SKU variant and requested/shipped/received quantities for a transfer.
model InventoryTransferItem {
  id                 String            @id @default(uuid()) @db.Uuid
  transferId         String            @map("transfer_id") @db.Uuid
  variantId          String            @map("variant_id") @db.Uuid
  quantityRequested  Decimal           @map("quantity_requested") @db.Decimal(12, 4)
  quantityShipped    Decimal           @default(0) @map("quantity_shipped") @db.Decimal(12, 4)
  quantityReceived   Decimal           @default(0) @map("quantity_received") @db.Decimal(12, 4)
  notes              String?           @db.VarChar(255)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  transfer           InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant            ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([transferId, variantId], name: "uq_transfer_items_transfer_variant")
  @@index([transferId], name: "idx_transfer_items_transfer_id")
  @@index([variantId], name: "idx_transfer_items_variant_id")
  @@map("inventory_transfer_items")
}

// ==============================================================================
// Supplier Management & Procurement Models (Stage 6)
// ==============================================================================

enum SupplierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SupplierProductStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  COMPLETED
  CANCELLED
}

/// Supplier: External vendor supplying goods and product variants.
model Supplier {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(150)
  code          String         @unique @db.VarChar(50)
  email         String?        @db.VarChar(255)
  phone         String?        @db.VarChar(50)
  website       String?        @db.VarChar(255)
  taxIdentifier String?        @map("tax_identifier") @db.VarChar(50)
  addressLine1  String?        @map("address_line_1") @db.VarChar(255)
  addressLine2  String?        @map("address_line_2") @db.VarChar(255)
  city          String?        @db.VarChar(100)
  state         String?        @db.VarChar(100)
  postalCode    String?        @map("postal_code") @db.VarChar(30)
  countryCode   String?        @map("country_code") @db.VarChar(10)
  status        SupplierStatus @default(ACTIVE)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([code], name: "idx_suppliers_code")
  @@index([status], name: "idx_suppliers_status")
  @@index([name], name: "idx_suppliers_name")
  @@map("suppliers")
}

/// SupplierProduct: Association binding suppliers to product variants with pricing and lead times.
model SupplierProduct {
  id                   String                @id @default(uuid()) @db.Uuid
  supplierId           String                @map("supplier_id") @db.Uuid
  variantId            String                @map("variant_id") @db.Uuid
  supplierSku          String?               @map("supplier_sku") @db.VarChar(100)
  supplierProductName  String?               @map("supplier_product_name") @db.VarChar(200)
  purchasePrice        Decimal               @map("purchase_price") @db.Decimal(12, 2)
  currencyCode         String                @default("USD") @map("currency_code") @db.VarChar(3)
  minimumOrderQuantity Decimal               @default(1) @map("minimum_order_quantity") @db.Decimal(12, 4)
  leadTimeDays         Int?                  @map("lead_time_days")
  isPreferred          Boolean               @default(false) @map("is_preferred")
  status               SupplierProductStatus @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  variant              ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  purchaseOrderItems   PurchaseOrderItem[]

  @@unique([supplierId, variantId], name: "uq_supplier_products_supplier_variant")
  @@index([supplierId], name: "idx_supplier_products_supplier_id")
  @@index([variantId], name: "idx_supplier_products_variant_id")
  @@index([status], name: "idx_supplier_products_status")
  @@map("supplier_products")
}

/// PurchaseOrder: Formal procurement order sent to a supplier for delivery to a destination store.
model PurchaseOrder {
  id                  String                @id @default(uuid()) @db.Uuid
  purchaseOrderNumber String                @unique @map("purchase_order_number") @db.VarChar(50)
  supplierId          String                @map("supplier_id") @db.Uuid
  destinationStoreId  String                @map("destination_store_id") @db.Uuid
  status              PurchaseOrderStatus   @default(DRAFT)
  currencyCode        String                @default("USD") @map("currency_code") @db.VarChar(3)
  subtotal            Decimal               @default(0) @db.Decimal(12, 2)
  discountTotal       Decimal               @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal            Decimal               @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal       Decimal               @default(0) @map("shipping_total") @db.Decimal(12, 2)
  grandTotal          Decimal               @default(0) @map("grand_total") @db.Decimal(12, 2)
  notes               String?               @db.Text
  createdByUserId     String?               @map("created_by_user_id") @db.Uuid
  approvedByUserId    String?               @map("approved_by_user_id") @db.Uuid
  approvedAt          DateTime?             @map("approved_at") @db.Timestamptz(6)
  orderedAt           DateTime?             @map("ordered_at") @db.Timestamptz(6)
  expectedDeliveryAt  DateTime?             @map("expected_delivery_at") @db.Timestamptz(6)
  cancelledAt         DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier            Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  destinationStore    Store                 @relation("PurchaseOrderDestinationStore", fields: [destinationStoreId], references: [id], onDelete: Restrict)
  createdByUser       User?                 @relation("PurchaseOrderCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedByUser      User?                 @relation("PurchaseOrderApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  items               PurchaseOrderItem[]
  goodsReceipts       GoodsReceipt[]
  statusHistory       PurchaseOrderStatusHistory[]

  @@index([purchaseOrderNumber], name: "idx_purchase_orders_number")
  @@index([supplierId], name: "idx_purchase_orders_supplier_id")
  @@index([destinationStoreId], name: "idx_purchase_orders_destination_store_id")
  @@index([status], name: "idx_purchase_orders_status")
  @@index([createdAt], name: "idx_purchase_orders_created_at")
  @@map("purchase_orders")
}

/// PurchaseOrderItem: Line item within a purchase order specifying ordered and received quantities and agreed pricing.
model PurchaseOrderItem {
  id                  String           @id @default(uuid()) @db.Uuid
  purchaseOrderId     String           @map("purchase_order_id") @db.Uuid
  variantId           String           @map("variant_id") @db.Uuid
  supplierProductId   String?          @map("supplier_product_id") @db.Uuid
  skuSnapshot         String           @map("sku_snapshot") @db.VarChar(100)
  productNameSnapshot String           @map("product_name_snapshot") @db.VarChar(200)
  supplierSkuSnapshot String?          @map("supplier_sku_snapshot") @db.VarChar(100)
  quantityOrdered     Decimal          @map("quantity_ordered") @db.Decimal(12, 4)
  quantityReceived    Decimal          @default(0) @map("quantity_received") @db.Decimal(12, 4)
  unitPrice           Decimal          @map("unit_price") @db.Decimal(12, 2)
  discountAmount      Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate             Decimal          @default(0) @map("tax_rate") @db.Decimal(5, 4)
  lineTotal           Decimal          @map("line_total") @db.Decimal(12, 2)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrder       PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant             ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  supplierProduct     SupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  goodsReceiptItems   GoodsReceiptItem[]

  @@index([purchaseOrderId], name: "idx_purchase_order_items_po_id")
  @@index([variantId], name: "idx_purchase_order_items_variant_id")
  @@map("purchase_order_items")
}

/// GoodsReceipt: Record of physical shipment delivery against a purchase order.
model GoodsReceipt {
  id                 String             @id @default(uuid()) @db.Uuid
  receiptNumber      String             @unique @map("receipt_number") @db.VarChar(50)
  purchaseOrderId    String             @map("purchase_order_id") @db.Uuid
  destinationStoreId String             @map("destination_store_id") @db.Uuid
  status             GoodsReceiptStatus @default(COMPLETED)
  receivedByUserId   String?            @map("received_by_user_id") @db.Uuid
  receivedAt         DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  deliveryReference  String?            @map("delivery_reference") @db.VarChar(100)
  notes              String?            @db.Text
  idempotencyKey     String?            @unique @map("idempotency_key") @db.VarChar(100)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrder      PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  destinationStore   Store              @relation("GoodsReceiptDestinationStore", fields: [destinationStoreId], references: [id], onDelete: Restrict)
  receivedByUser     User?              @relation("GoodsReceiptReceivedByUser", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  items              GoodsReceiptItem[]

  @@index([receiptNumber], name: "idx_goods_receipts_number")
  @@index([purchaseOrderId], name: "idx_goods_receipts_po_id")
  @@index([destinationStoreId], name: "idx_goods_receipts_store_id")
  @@index([idempotencyKey], name: "idx_goods_receipts_idempotency")
  @@index([receivedAt], name: "idx_goods_receipts_received_at")
  @@map("goods_receipts")
}

/// GoodsReceiptItem: Specific delivery line item with accepted and rejected quantities and reasons.
model GoodsReceiptItem {
  id                  String            @id @default(uuid()) @db.Uuid
  goodsReceiptId      String            @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String            @map("purchase_order_item_id") @db.Uuid
  variantId           String            @map("variant_id") @db.Uuid
  quantityDelivered   Decimal           @map("quantity_delivered") @db.Decimal(12, 4)
  quantityAccepted    Decimal           @map("quantity_accepted") @db.Decimal(12, 4)
  quantityRejected    Decimal           @default(0) @map("quantity_rejected") @db.Decimal(12, 4)
  rejectionReason     String?           @map("rejection_reason") @db.VarChar(255)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  variant             ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId], name: "idx_goods_receipt_items_receipt_id")
  @@index([purchaseOrderItemId], name: "idx_goods_receipt_items_po_item_id")
  @@index([variantId], name: "idx_goods_receipt_items_variant_id")
  @@map("goods_receipt_items")
}

/// PurchaseOrderStatusHistory: Immutable audit log of purchase order lifecycle transitions.
model PurchaseOrderStatusHistory {
  id              String              @id @default(uuid()) @db.Uuid
  purchaseOrderId String              @map("purchase_order_id") @db.Uuid
  fromStatus      PurchaseOrderStatus @map("from_status")
  toStatus        PurchaseOrderStatus @map("to_status")
  changedByUserId String?             @map("changed_by_user_id") @db.Uuid
  reason          String?             @db.VarChar(255)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder   PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  changedByUser   User?               @relation("POStatusChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId], name: "idx_po_status_history_po_id")
  @@index([createdAt], name: "idx_po_status_history_created_at")
  @@map("purchase_order_status_history")
}

// ==============================================================================
// Sales, Checkout, Payments & Receipts Models (Stage 7)
// ==============================================================================

enum SaleStatus {
  DRAFT
  PENDING_PAYMENT
  COMPLETED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  EXTERNAL_DIGITAL
  STORE_CREDIT
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Sale: Central point-of-sale transaction record tracking checkout state and financial totals.
model Sale {
  id             String      @id @default(uuid()) @db.Uuid
  saleNumber     String      @unique @map("sale_number") @db.VarChar(50)
  storeId        String      @map("store_id") @db.Uuid
  status         SaleStatus  @default(DRAFT)
  currencyCode   String      @default("USD") @map("currency_code") @db.VarChar(3)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal       Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal     Decimal     @default(0) @map("grand_total") @db.Decimal(12, 2)
  amountPaid     Decimal     @default(0) @map("amount_paid") @db.Decimal(12, 2)
  amountRefunded Decimal     @default(0) @map("amount_refunded") @db.Decimal(12, 2)
  cashierUserId  String?     @map("cashier_user_id") @db.Uuid
  idempotencyKey String?     @unique @map("idempotency_key") @db.VarChar(100)
  notes          String?     @db.Text
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(6)
  cancelledAt    DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  store          Store       @relation("SaleStore", fields: [storeId], references: [id], onDelete: Restrict)
  cashierUser    User?       @relation("SaleCashierUser", fields: [cashierUserId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]
  refunds        Refund[]
  receipt        Receipt?

  @@index([saleNumber], name: "idx_sales_number")
  @@index([storeId], name: "idx_sales_store_id")
  @@index([status], name: "idx_sales_status")
  @@index([idempotencyKey], name: "idx_sales_idempotency")
  @@index([createdAt], name: "idx_sales_created_at")
  @@map("sales")
}

/// SaleItem: Line item within a sale recording unit price, tax, discount, and frozen catalog snapshots.
model SaleItem {
  id                  String         @id @default(uuid()) @db.Uuid
  saleId              String         @map("sale_id") @db.Uuid
  variantId           String         @map("variant_id") @db.Uuid
  skuSnapshot         String         @map("sku_snapshot") @db.VarChar(100)
  productNameSnapshot String         @map("product_name_snapshot") @db.VarChar(200)
  variantNameSnapshot String?        @map("variant_name_snapshot") @db.VarChar(150)
  quantity            Decimal        @db.Decimal(12, 4)
  unitPrice           Decimal        @map("unit_price") @db.Decimal(12, 2)
  discountAmount      Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate             Decimal        @default(0) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount           Decimal        @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal           Decimal        @map("line_total") @db.Decimal(12, 2)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  sale                Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([saleId], name: "idx_sale_items_sale_id")
  @@index([variantId], name: "idx_sale_items_variant_id")
  @@map("sale_items")
}

/// Payment: Monetary transaction attempt and settlement record linked to a sale.
model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  saleId                String        @map("sale_id") @db.Uuid
  paymentReference      String        @unique @map("payment_reference") @db.VarChar(50)
  paymentMethod         PaymentMethod @map("payment_method")
  status                PaymentStatus @default(PENDING)
  amount                Decimal       @db.Decimal(12, 2)
  currencyCode          String        @default("USD") @map("currency_code") @db.VarChar(3)
  provider              String        @default("CASH") @db.VarChar(50)
  providerTransactionId String?       @map("provider_transaction_id") @db.VarChar(100)
  idempotencyKey        String?       @unique @map("idempotency_key") @db.VarChar(100)
  failureCode           String?       @map("failure_code") @db.VarChar(50)
  failureMessage        String?       @map("failure_message") @db.VarChar(255)
  initiatedAt           DateTime      @default(now()) @map("initiated_at") @db.Timestamptz(6)
  authorizedAt          DateTime?     @map("authorized_at") @db.Timestamptz(6)
  capturedAt            DateTime?     @map("captured_at") @db.Timestamptz(6)
  failedAt              DateTime?     @map("failed_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  sale                  Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  refunds               Refund[]

  @@index([paymentReference], name: "idx_payments_reference")
  @@index([saleId], name: "idx_payments_sale_id")
  @@index([status], name: "idx_payments_status")
  @@index([idempotencyKey], name: "idx_payments_idempotency")
  @@index([capturedAt], name: "idx_payments_captured_at")
  @@map("payments")
}

/// Refund: Reversal and refund transaction record for an eligible captured payment.
model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @map("payment_id") @db.Uuid
  saleId            String       @map("sale_id") @db.Uuid
  refundReference   String       @unique @map("refund_reference") @db.VarChar(50)
  amount            Decimal      @db.Decimal(12, 2)
  currencyCode      String       @default("USD") @map("currency_code") @db.VarChar(3)
  status            RefundStatus @default(PENDING)
  reason            String       @db.VarChar(255)
  providerRefundId  String?      @map("provider_refund_id") @db.VarChar(100)
  idempotencyKey    String?      @unique @map("idempotency_key") @db.VarChar(100)
  requestedByUserId String?      @map("requested_by_user_id") @db.Uuid
  processedAt       DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  sale              Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  requestedByUser   User?        @relation("RefundRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([refundReference], name: "idx_refunds_reference")
  @@index([paymentId], name: "idx_refunds_payment_id")
  @@index([saleId], name: "idx_refunds_sale_id")
  @@index([status], name: "idx_refunds_status")
  @@index([idempotencyKey], name: "idx_refunds_idempotency")
  @@map("refunds")
}

/// Receipt: Immutable frozen customer receipt snapshot generated upon sale completion.
model Receipt {
  id                   String   @id @default(uuid()) @db.Uuid
  receiptNumber        String   @unique @map("receipt_number") @db.VarChar(50)
  saleId               String   @unique @map("sale_id") @db.Uuid
  storeId              String   @map("store_id") @db.Uuid
  storeNameSnapshot    String   @map("store_name_snapshot") @db.VarChar(150)
  storeAddressSnapshot String?  @map("store_address_snapshot") @db.VarChar(255)
  cashierNameSnapshot  String   @map("cashier_name_snapshot") @db.VarChar(100)
  receiptData          Json     @map("receipt_data") @db.JsonB
  issuedAt             DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sale                 Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  store                Store    @relation("ReceiptStore", fields: [storeId], references: [id], onDelete: Restrict)

  @@index([receiptNumber], name: "idx_receipts_number")
  @@index([saleId], name: "idx_receipts_sale_id")
  @@index([storeId], name: "idx_receipts_store_id")
  @@index([issuedAt], name: "idx_receipts_issued_at")
  @@map("receipts")
}

// ==============================================================================
// Reporting, Analytics & Background Job Models (Stage 8)
// ==============================================================================

enum ReportType {
  SALES_SUMMARY
  TOP_PRODUCTS
  PAYMENT_SUMMARY
  INVENTORY_SUMMARY
  LOW_STOCK
  PROCUREMENT_SUMMARY
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

/// ReportRequest: Persistent tracking record for asynchronous and large date-range reports.
model ReportRequest {
  id                String       @id @default(uuid()) @db.Uuid
  reportNumber      String       @unique @map("report_number") @db.VarChar(50)
  reportType        ReportType   @map("report_type")
  status            ReportStatus @default(PENDING)
  storeId           String       @map("store_id") @db.Uuid
  requestedByUserId String       @map("requested_by_user_id") @db.Uuid
  parameters        Json         @db.JsonB
  resultData        Json?        @map("result_data") @db.JsonB
  errorMessage      String?      @map("error_message") @db.VarChar(500)
  expiresAt         DateTime?    @map("expires_at") @db.Timestamptz(6)
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  store             Store        @relation("StoreReportRequests", fields: [storeId], references: [id], onDelete: Restrict)
  requestedByUser   User         @relation("UserReportRequests", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([reportNumber], name: "idx_report_requests_number")
  @@index([storeId], name: "idx_report_requests_store_id")
  @@index([status], name: "idx_report_requests_status")
  @@index([reportType], name: "idx_report_requests_type")
  @@index([createdAt], name: "idx_report_requests_created_at")
  @@map("report_requests")
}

/// OutboxEvent: Minimal transactional outbox for durable asynchronous event and job dispatch.
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error") @db.VarChar(500)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt], name: "idx_outbox_events_status_created")
  @@index([aggregateType, aggregateId], name: "idx_outbox_events_aggregate")
  @@map("outbox_events")
}




